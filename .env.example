# ==============================================================
# Casio Watch Discount Tracker & Alerter — Environment Variables
# ==============================================================

# Target Store Configuration
BASE_URL=https://casiostore.bhawar.com
TRACK_ALL_STORE=false               # Set to 'true' to scan the entire store catalog (/products.json)

# Discount & Alert Thresholds
MIN_DISCOUNT_PERCENT=1             # Minimum discount to ingest (default: 1%)
ALERT_MIN_DISCOUNT_PERCENT=5       # Minimum discount to trigger a notification (default: 5%)
ALERT_IN_STOCK_ONLY=true           # Only alert on watches ready to ship (default: true)
FORCE_ALERT_ALL=false              # Force alerts for all current deals (ignores delta history)
DRY_RUN=false                      # Test mode: skips writing to disk and sending live notifications

# Telegram Bot Alerts
TELEGRAM_BOT_TOKEN=                # From @BotFather (e.g. 123456789:ABCdefGHIjklMNO)
TELEGRAM_CHAT_ID=                  # Your Telegram user ID or channel ID from @userinfobot

# Discord Webhook Alerts
DISCORD_WEBHOOK_URL=               # Server Channel -> Settings -> Integrations -> Webhook URL

# NTFY Mobile & Browser Push (Free, no account needed)
NTFY_TOPIC=                        # Unique topic name (e.g. casio-deals-yourname)
NTFY_SERVER=https://ntfy.sh        # Default public server or your self-hosted instance

# Network & Retry Settings
RETRY_ATTEMPTS=3                   # Retries on HTTP 429 or 5xx server errors
RETRY_BASE_DELAY_MS=1000           # Base exponential backoff delay in milliseconds

